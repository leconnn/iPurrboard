<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the front-on keycap the launch intro grows from (the app icon is the
     close-up logo). Built like the app icon so the splash draws it at the same size. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_key_background" />
    <foreground android:drawable="@drawable/splash_key_foreground" />
</adaptive-icon>
