<?xml version="1.0" encoding="utf-8"?>
<!-- iOS navigation push / pop: the new page slides over from the right edge while the page under it
     drifts a third of the way left (and back). -->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromXDelta="100%" android:toXDelta="0"
    android:duration="380"
    android:interpolator="@interpolator/ios_navigation" />
