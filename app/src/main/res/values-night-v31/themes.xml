<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a splash before the app draws: give it the launch intro's ground (the
         logo's plum-brown) so the intro starts from the same screen. -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowAnimationStyle">@style/IosPushAnimation</item>
        <item name="android:windowSplashScreenBackground">#24171A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_key</item>
    </style>
</resources>
